# Copy to .env.local for local development. Real values live in Vercel.

# Resend. Required for the enquiry form, the journal sign-up and the checklist.
RESEND_API_KEY=

# The Resend segment checklist sign-ups are added to. Create the segment in
# the Resend dashboard (Audience -> Segments) and paste its id here.
RESEND_CHECKLIST_SEGMENT_ID=
